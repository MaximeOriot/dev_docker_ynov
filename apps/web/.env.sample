# A secret key used to encrypt user sessions (required, at least 32 characters)
# Generate a random secret key using: openssl rand -hex 32
SECRET_PASSWORD=

# The base url where this instance is accessible, including the scheme.
# Example: https://example.com
# Local dev (pnpm dev): https://web.rallly.test
# docker-compose.yml (no reverse proxy, port 3000): http://localhost:3000
# It also fixes the OAuth/OIDC callback urls, so change it before registering
# the client with your identity provider.
NEXT_PUBLIC_BASE_URL=https://web.rallly.test

# Optional. Base url for links handed to participants (poll invites, event
# pages) when they should live on another domain that redirects here.
# Defaults to NEXT_PUBLIC_BASE_URL.
# NEXT_PUBLIC_SHORT_BASE_URL=https://example.com

# A connection string to your Postgres database
# docker-compose.yml overrides this to point at its own rallly_db service.
# With docker-compose.dev.yml keep it in sync with POSTGRES_* below.
DATABASE_URL=postgres://postgres:postgres@localhost:5450/rallly

# Read by docker-compose.dev.yml (pnpm docker:up) and docker-compose.yml
# (`docker compose --env-file apps/web/.env up`) to create the database; the
# app itself only uses DATABASE_URL. Change the password before running
# `pnpm docker:up` for the first time: the data volume keeps the first one.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rallly

# Required to be able to send emails
SUPPORT_EMAIL=support@rallly.co

# The first user who signs in with this email can claim the admin role at
# /control-panel.
# INITIAL_ADMIN_EMAIL=

# --- Local dev services (docker-compose.dev.yml) ---
# The SMTP, S3 and KV defaults below only work with `pnpm dev` on the host.
# When the app runs inside docker-compose.yml these addresses are unreachable
# from the container: set a real SMTP server (sign-in codes are sent by email)
# and comment out every S3_* and KV_* variable.

# SMTP settings for sending emails
# Defaults below are configured for the local Mailpit instance (see docker-compose.dev.yml)
SMTP_HOST=0.0.0.0
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PWD=

# --- Sign-in (optional) ---
# Set to false to disable email sign-in. Users then sign in through an SSO
# provider only; make sure one works first or nobody can log in.
# EMAIL_LOGIN_ENABLED=true
# Set to false to stop new accounts from being created.
# REGISTRATION_ENABLED=true
# Comma-separated emails allowed to register and sign in. Wildcards work.
# ALLOWED_EMAILS=*@example.com

# OpenID Connect (Authentik, Keycloak, ...). All three of DISCOVERY_URL,
# CLIENT_ID and CLIENT_SECRET are needed to enable it.
# Callback url to register with the provider: <base url>/api/auth/callback/oidc
# OIDC_NAME=Authentik
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/rallly/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Claim paths, in dot notation for nested objects.
# OIDC_NAME_CLAIM_PATH=name
# OIDC_EMAIL_CLAIM_PATH=email
# OIDC_PICTURE_CLAIM_PATH=picture

# Reserve voting for people who signed in through an OAuth provider (Google,
# Microsoft or OIDC). Guests and email-only accounts can view a poll but not
# respond. Requires at least one SSO provider, otherwise nobody can vote.
# VOTE_REQUIRES_OAUTH=false
# Refuse OAuth sign-ins whose email address the provider does not vouch for
# (`email_verified`). Many OIDC providers omit that claim: check yours first.
# OAUTH_REQUIRE_VERIFIED_EMAIL=false

# Object Storage (S3) (optional)
# Defaults below are configured for the local Garage instance (see docker-compose.dev.yml),
# which is created with these same keys and bucket.
S3_BUCKET_NAME=rallly
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY_ID=rallly-access-key
S3_SECRET_ACCESS_KEY=rallly-secret-key
S3_REGION=garage
# Optional: serve stored assets directly from a CDN instead of proxying through /api/storage/
# NEXT_PUBLIC_CDN_BASE_URL=https://example.cloudfront.net

# KV (Redis) (optional)
# Defaults below are configured for the local Redis instance (see docker-compose.dev.yml),
# whose HTTP proxy uses KV_REST_API_TOKEN as its token.
KV_REST_API_URL=http://0.0.0.0:8079
KV_REST_API_TOKEN=dev_fake_token_123456789abcdefghijklmnop

# Toggle Self-Hosted mode
# Enable to remove the pay-wall and subscription billing functionality.
# Leave unset with docker-compose.yml: its image is built with SELF_HOSTED=true
# and a value here would contradict it.
# NEXT_PUBLIC_SELF_HOSTED=false

# Conferencing integrations (optional). Set CONFERENCING_ENABLED=true to let
# users connect Zoom, Google Meet, Microsoft Teams and Webex and add meeting
# links to their events. Google Meet reuses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET.
# Microsoft Teams reuses MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET: the
# registration needs the delegated Microsoft Graph permission
# OnlineMeetings.ReadWrite and the redirect URI
# <base url>/api/integrations/callback/microsoft-teams. Teams connects through
# the `organizations` authority when MICROSOFT_TENANT_ID is common or
# consumers, and through the configured tenant otherwise.
# CONFERENCING_ENABLED=false
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Secret Token from the Zoom app's Features page; verifies deauthorization events.
# ZOOM_WEBHOOK_SECRET_TOKEN=
# Webex integration from developer.webex.com with the scopes
# meeting:schedules_write and spark:people_read and the redirect URI
# <base url>/api/integrations/callback/webex.
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=
